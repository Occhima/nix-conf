{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
      "type": "local"
    },
    "engram": {
      "command": ["engram", "mcp"],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "./.env": "deny",
      "./.env.*": "deny",
      "./secrets/**": "deny",
      "./venv/**": "deny",
      "./config/credentials.json": "deny"
    }
  }
}
