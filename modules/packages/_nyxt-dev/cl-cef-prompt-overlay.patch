+void cl_cef_window_add_overlay(int window_id, int view_id) {
+  auto window = FindWindow(window_id);
+  auto view = FindView(view_id);
+  CallUI([window, view]() {
+    if (!window || !window->window || !view || !view->widget || view->overlay)
+      return;
+    if (CefRefPtr<CefView> parent = view->widget->GetParentView()) {
+      if (auto panel = parent->AsPanel())
+        panel->RemoveChildView(view->widget);
+    }
+    view->overlay = window->window->AddOverlayView(view->widget, CEF_DOCKING_MODE_CUSTOM, true);
+  });
+}
+
+void cl_cef_view_set_overlay(int view_id, int visible, int x, int y, int width, int height) {
+  auto view = FindView(view_id);
+  CallUI([view, visible, x, y, width, height]() {
+    if (!view || !view->overlay || !view->overlay->IsValid())
+      return;
+    if (visible)
+      view->overlay->SetBounds(CefRect(x, y, width, height));
+    view->overlay->SetVisible(visible != 0);
+  });
+}
