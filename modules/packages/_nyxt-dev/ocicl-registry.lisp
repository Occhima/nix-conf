(let ((systems (make-hash-table :test 'equal))
      (root (uiop:ensure-directory-pathname (uiop:getenv "OCICL_DIR"))))
  (with-open-file (in (uiop:getenv "OCICL_CSV"))
    (loop for line = (read-line in nil)
          while line
          do (destructuring-bind (name source asd)
                 (mapcar (lambda (field) (string-trim " " field))
                         (uiop:split-string line :separator ","))
               (declare (ignore source))
               (let ((file (merge-pathnames asd root)))
                 (when (and (probe-file file)
                            (not (member name '("nyxt" "nasdf") :test #'string=))
                            (not (uiop:string-prefix-p "nyxt/" name)))
                   (setf (gethash (uiop:frob-substrings name (list "_plus_") "+") systems) file))))))
  (push (lambda (name) (gethash (asdf:coerce-name name) systems))
        asdf:*system-definition-search-functions*))
